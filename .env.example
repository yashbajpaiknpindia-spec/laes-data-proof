# Public leader data via Kopyon v5 when configured; never commit the API key.
KOPYON_API_KEY=
KOPYON_BASE_URL=https://api.kopyon.com/v5
# Default budget: 1 leaderboard page/hour + 20 per-leader position reads every 20 minutes (~43k calls/30d; needs a paid Kopyon plan).
# Kopyon's public Binance Copy Trading positions refresh about every 5 minutes.
KOPYON_DISCOVERY_INTERVAL_SECONDS=7200
KOPYON_POSITION_REFRESH_INTERVAL_SECONDS=600
KOPYON_POSITION_BATCH=20
KOPYON_DISCOVERY_PAGES=6

# Binance official market data; no Binance account credentials are used.
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_COPY_ROOT=https://www.binance.com/bapi/futures/v1/friendly/future/copy-trade

# Use persistent PostgreSQL in production; SQLite is for local development.
DATABASE_URL=sqlite:///./laes_local.db

APP_ENV=production
LAES_MODE=paper
PYTHON_VERSION=3.12.8
LAES_DISCOVERY_INTERVAL_SECONDS=1800
LAES_POSITION_BATCH=20
LAES_TRADER_DISCOVERY_PAGES=5
# Shared in-process rolling budget for ALL Binance HTTP calls.
LAES_BINANCE_REST_WEIGHT_BUDGET_PER_MINUTE=60

# Leader screening defaults.
LAES_LEADER_MIN_TRADING_DAYS=14
LAES_LEADER_MIN_30D_ROI_PCT=0
LAES_LEADER_MIN_WIN_RATE_PCT=50
LAES_LEADER_MAX_30D_DRAWDOWN_PCT=40
LAES_LEADER_MIN_SHARPE=0

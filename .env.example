# Kopyon key stays on the server; never expose it in browser JavaScript.
KOPYON_API_KEY=
KOPYON_BASE_URL=https://api.kopyon.com/v5
BINANCE_BASE_URL=https://fapi.binance.com

# Use Render PostgreSQL in production. SQLite is for local development only.
DATABASE_URL=sqlite:///./laes_local.db

APP_ENV=production
LAES_MODE=paper
PYTHON_VERSION=3.12.8
LAES_DISCOVERY_INTERVAL_SECONDS=1800
LAES_POSITION_BATCH=5
# Optional only if your Render database plan exposes a specific capacity.
# DATABASE_CAPACITY_GB=
